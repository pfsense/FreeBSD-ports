+		(acladdr->taglist || acladdr->view))) {
 		cinfo_tmp.taglist = acladdr->taglist;
 		cinfo_tmp.taglen = acladdr->taglen;
 		cinfo_tmp.tag_actions = acladdr->tag_actions;
