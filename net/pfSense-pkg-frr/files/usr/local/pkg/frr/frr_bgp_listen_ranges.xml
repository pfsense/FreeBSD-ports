	<adddeleteeditpagefields>
		<columnitem>
			<fielddescr>Prefix</fielddescr>
			<fieldname>prefix</fieldname>
		</columnitem>
		<columnitem>
			<fielddescr>Peer Group</fielddescr>
			<fieldname>peergroup</fieldname>
		</columnitem>
		<columnitem>
			<fielddescr>Description</fielddescr>
			<fieldname>descr</fieldname>
		</columnitem>
	</adddeleteeditpagefields>
	<fields>
		<field>
			<fielddescr>Prefix</fielddescr>
			<fieldname>prefix</fieldname>
			<description>
				<![CDATA[
				IPv4 or IPv6 network in CIDR notation used for dynamic BGP neighbors
				(<code>bgp listen range &lt;prefix&gt; peer-group &lt;name&gt;</code>).
				]]>
			</description>
			<type>input</type>
			<size>40</size>
			<required/>
		</field>
		<field>
			<fielddescr>Peer Group</fielddescr>
			<fieldname>peergroup</fieldname>
			<description>
				<![CDATA[
				Peer-group that dynamic neighbors matching this prefix will join.
				Create a peer-group under Neighbors (non-IP name) first.
				]]>
			</description>
			<type>select_source</type>
			<source><![CDATA[frr_get_bgp_neighbor_list(true, false, false)]]></source>
			<source_name>name</source_name>
			<source_value>value</source_value>
			<required/>
		</field>
		<field>
			<fielddescr>Description</fielddescr>
			<fieldname>descr</fieldname>
			<size>50</size>
			<type>input</type>
		</field>
	</fields>
	<custom_delete_php_command>
